<navigation-bar title="学习记录" back="{{true}}" color="#1b2538" background="#f5f7fb"></navigation-bar>
<scroll-view class="scrollarea" scroll-y="true" type="list">
  <view class="page">
    <view class="summary">
      <text class="title">连续打卡 {{streak}} 天</text>
      <text class="desc">每天完成 3 个单词后会记录在这里</text>
    </view>

    <view wx:if="{{history.length === 0}}" class="empty">
      <text>还没有完成记录，先去背今天的 3 个单词。</text>
    </view>

    <block wx:for="{{history}}" wx:key="dateKey" wx:for-item="item">
      <view class="history-item">
        <text class="date">{{item.dateKey}}</text>
        <text class="tag">已完成</text>
      </view>
    </block>
  </view>
</scroll-view>
