<navigation-bar title="每日3词" back="{{navBack}}" color="#1b2538" background="#f5f7fb"></navigation-bar>
<scroll-view class="scrollarea" scroll-y="true" type="list">
  <view class="page">
    <view class="summary">
      <view class="summary-top">
        <text class="summary-date">{{dateLabel}}</text>
        <text class="summary-streak">连续 {{streak}} 天</text>
      </view>
      <text class="title">{{summaryTitle}}</text>
      <text class="desc">{{isHistoryMode ? '历史回看模式：可继续学习并播放发音。' : '左右滑动卡片学习，点“显示释义”计入完成。'}}</text>
      <view class="progress">进度 {{viewedCount}} / 3</view>
      <button class="history-btn" bindtap="goHistory">查看学习记录</button>
    </view>

    <view wx:if="{{completionActionVisible}}" class="complete-panel">
      <text class="complete-title">今日 3 词已完成</text>
      <text class="complete-desc">你可以再看一遍，或主动结束本次学习。</text>
      <view class="complete-actions">
        <button class="complete-btn review" bindtap="onReviewAgain">再看一遍</button>
        <button class="complete-btn exit" bindtap="onStartExitCountdown">完成并退出</button>
      </view>
    </view>

    <view wx:if="{{exitCountdownVisible}}" class="countdown-banner">
      <text class="countdown-text">即将退出：{{exitCountdown}} 秒</text>
      <view class="countdown-actions">
        <button wx:if="{{exitFallbackVisible}}" class="exit-now-btn" bindtap="onExitNow">立即退出</button>
        <button class="cancel-exit-btn" bindtap="onCancelExitCountdown">取消退出</button>
      </view>
    </view>

    <swiper class="card-swiper" circular="false" previous-margin="32rpx" next-margin="32rpx" bindchange="onSwiperChange" current="{{currentIndex}}">
      <block wx:for="{{cards}}" wx:key="id" wx:for-item="card">
        <swiper-item>
          <view class="card">
            <view class="card-head">
              <text class="badge {{card.viewed ? 'done' : ''}}">{{card.viewed ? '已完成' : '学习中'}}</text>
              <text class="card-index">{{index + 1}} / 3</text>
            </view>

            <text class="word">{{card.text}}</text>
            <text class="phonetic">{{card.phonetic}}</text>

            <view class="btn-row">
              <button class="play-btn" data-word="{{card.text}}" bindtap="onPlayPronunciation">播放发音</button>
              <button class="example-btn" data-id="{{card.id}}" bindtap="onToggleExample">
                {{card.exampleVisible ? '收起例句' : '查看例句'}}
              </button>
            </view>

            <button class="reveal-btn" data-id="{{card.id}}" bindtap="onToggleReveal">
              {{card.revealed ? '收起释义' : '显示释义'}}
            </button>

            <view wx:if="{{card.revealed}}" class="meaning-box">
              <text class="meaning">{{card.meaning}}</text>
            </view>

            <view wx:if="{{card.exampleVisible}}" class="example-box">
              <text class="example-title">Example</text>
              <view class="example-playable" data-example="{{card.example}}" bindtap="onPlayExample">
                <text class="example example-clickable">{{card.example}}</text>
              </view>
              <text class="example-cn">{{card.exampleCn}}</text>
            </view>
          </view>
        </swiper-item>
      </block>
    </swiper>
  </view>
</scroll-view>
